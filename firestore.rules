rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Minimal auditable helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Legacy user profiles collection (contains PII: email)
    // Owner-only single-document read; no listing; all mutations server-authoritative only
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Club channels collection
    // Authenticated reads for valid channel IDs; all mutations server-authoritative only
    match /channels/{channelId} {
      allow get: if isSignedIn() && isValidId(channelId);
      allow list: if isSignedIn();
      allow create, update, delete: if false;

      // Club messages subcollection
      // Authenticated reads for valid channel IDs; all client writes denied to prevent identity/tier/credit spoofing
      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(channelId) && isValidId(messageId);
        allow list: if isSignedIn() && isValidId(channelId);
        allow create, update, delete: if false;
      }
    }
  }
}
