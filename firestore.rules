rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for User documents
    function isValidUser(userId) {
      let data = incoming();
      return data.keys().hasAll(['uid', 'email', 'displayName']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'tier', 'color', 'avatarUrl', 'createdAt']) &&
             data.uid == request.auth.uid &&
             data.uid == userId &&
             data.email is string && data.email.size() > 3 && data.email.size() <= 256 &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             (!('tier' in data) || (data.tier is string && data.tier.size() <= 50)) &&
             (!('color' in data) || (data.color is string && data.color.size() <= 30)) &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 2048)) &&
             (!('createdAt' in data) || (data.createdAt is number));
    }

    // Validation for ClubMessage documents
    function isValidClubMessage(channelId) {
      let data = incoming();
      return data.keys().hasAll(['channelId', 'senderId', 'senderName', 'text', 'timestamp']) &&
             data.keys().hasOnly(['channelId', 'senderId', 'senderName', 'senderTier', 'senderColor', 'avatarUrl', 'text', 'timestamp', 'accolades']) &&
             data.channelId == channelId &&
             data.senderId == request.auth.uid &&
             data.senderName is string && data.senderName.size() > 0 && data.senderName.size() <= 100 &&
             data.text is string && data.text.size() > 0 && data.text.size() <= 2000 &&
             data.timestamp is number &&
             (!('senderTier' in data) || (data.senderTier is string && data.senderTier.size() <= 50)) &&
             (!('senderColor' in data) || (data.senderColor is string && data.senderColor.size() <= 30)) &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 2048));
    }

    // User profiles collection
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(userId) && isValidUser(userId);
      allow update: if isSignedIn() && isValidId(userId) && isOwner(userId) && isValidUser(userId);
      allow delete: if false;
    }

    // Channels collection
    match /channels/{channelId} {
      allow read: if isSignedIn() && isValidId(channelId);
      allow write: if false;

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isSignedIn() && isValidId(channelId);
        allow create: if isSignedIn() && isValidId(channelId) && isValidId(messageId) && isValidClubMessage(channelId);
        allow update, delete: if false;
      }
    }
  }
}
